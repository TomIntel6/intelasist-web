---
/**
 * Confianza empresarial.
 * No existe evidencia aprobada (logos de socios, métricas fechadas o caso verificable),
 * por lo que, siguiendo el brief, se muestra la misión publicada y los canales de contacto.
 * TODO(dirección): entregar socios autorizados / métricas con período y fuente para activar
 * la variante con evidencia.
 */
import { company } from '../content/site';
---
<section class="section proof" aria-labelledby="proof-title">
  <div class="container proof__grid">
    <div>
      <p class="eyebrow">Nuestro compromiso</p>
      <h2 id="proof-title">Un servicio humano, de principio a fin.</h2>
    </div>
    <div class="proof__body">
      <blockquote class="proof__quote">
        <p>“{company.mission.text}”</p>
        <footer class="small muted">Misión de {company.legalName}</footer>
      </blockquote>
      <div class="proof__contacts">
        <a href={company.phone.href} class="proof__chip">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          <span><strong>Asistencia 24/7</strong><br />{company.phone.display}</span>
        </a>
        <a href={company.email.href} class="proof__chip">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span><strong>Empresas y proveedores</strong><br />{company.email.display}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .proof__grid { display: grid; gap: var(--s-8); grid-template-columns: 1fr; }
  .proof__grid .eyebrow { margin-bottom: var(--s-4); }
  .proof__quote { margin: 0; padding-left: var(--s-6); border-left: 4px solid; border-image: linear-gradient(180deg, var(--brand-navy) 0 50%, var(--brand-blue) 50% 100%) 1; }
  .proof__quote p { font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.625rem); font-weight: 600; line-height: 1.4; color: var(--brand-navy); text-wrap: pretty; }
  .proof__quote footer { margin-top: var(--s-4); }
  .proof__contacts { display: grid; gap: var(--s-4); grid-template-columns: 1fr; margin-top: var(--s-8); }
  .proof__chip {
    display: flex; align-items: center; gap: var(--s-4); padding: var(--s-4) var(--s-6);
    border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface-alt);
    text-decoration: none; color: var(--color-text); line-height: 1.35;
    transition: border-color var(--t-base) var(--ease), background var(--t-base) var(--ease);
  }
  .proof__chip:hover { border-color: var(--brand-blue); background: #fff; color: var(--color-text); }
  .proof__chip .icon { color: var(--brand-blue); }
  .proof__chip strong { color: var(--brand-navy); }
  @media (min-width: 640px) { .proof__contacts { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .proof__grid { grid-template-columns: 0.8fr 1.2fr; gap: var(--s-16); } }
</style>
