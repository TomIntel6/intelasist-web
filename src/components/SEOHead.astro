---
import { company } from '../content/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica relativa, p. ej. "/servicios/asistencia-vial" */
  path: string;
  /** JSON-LD adicional (se concatena al Organization) */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://intelasist.com';
const canonical = path === '/' ? `${site}/` : `${site}${path}`;
const ogImage = `${site}/images/og-intelasist.png`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.brand,
  legalName: company.legalName,
  url: site,
  logo: `${site}/images/logo-intelasist.png`,
  email: company.email.display,
  telephone: company.phone.display,
  areaServed: { '@type': 'Country', name: 'Panamá' },
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: company.phone.display,
    email: company.email.display,
    contactType: 'customer service',
    availableLanguage: ['es'],
    areaServed: 'PA',
  }],
};
const blocks = [organization, ...jsonLd];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#163E64" />
<meta name="author" content={company.legalName} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={company.brand} />
<meta property="og:locale" content="es_PA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
<link rel="preload" href="/fonts/manrope-latin-var.woff2" as="font" type="font/woff2" crossorigin />

{blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
