---
import { trust } from '../content/site';
const icons = [
  `<path d="M12 7v5l3 2"/><circle cx="12" cy="12" r="9"/>`,
  `<path d="M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10z"/><circle cx="12" cy="11" r="2"/>`,
  `<path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="9" r="4"/>`,
];
---
<section class="trust" aria-label="Atributos de confianza">
  <div class="container">
    <ul class="trust__list">
      {trust.map((t, i) => (
        <li class="trust__item">
          <span class="trust__icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i]} /></span>
          <div>
            <p class="trust__label">{t.label}</p>
            <p class="trust__detail">{t.detail}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust { background: var(--color-surface-alt); border-block: 1px solid var(--color-border); }
  .trust__list { display: grid; grid-template-columns: 1fr; }
  .trust__item { display: flex; flex-direction: column; gap: var(--s-3); align-items: center; text-align: center; padding: var(--s-6) 0; border-top: 1px solid var(--color-border); }
  .trust__item:first-child { border-top: 0; }
  .trust__icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: #fff; border: 1px solid var(--color-border); color: var(--brand-blue); flex: none; }
  .trust__label { font-family: var(--font-display); font-weight: 700; color: var(--brand-navy); }
  .trust__detail { color: var(--color-text-muted); font-size: var(--fs-small); }
  @media (min-width: 768px) {
    .trust__list { grid-template-columns: repeat(3, 1fr); }
    .trust__item { flex-direction: row; gap: var(--s-4); text-align: left; border-top: 0; border-left: 1px solid var(--color-border); padding: var(--s-6) var(--s-8); }
    .trust__item:first-child { border-left: 0; padding-left: 0; }
  }
</style>
