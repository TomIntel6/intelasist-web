---
import { company, nav } from '../content/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="/images/logo-intelasist-white.png" alt="Intelasist" width="1048" height="157" loading="lazy" />
        <p class="footer__legal">{company.legalName}<br />{company.country}</p>
        <p class="footer__mission">{company.mission.text}</p>
      </div>

      <div>
        <h2 class="footer__h">Asistencia</h2>
        <p class="footer__note">{company.availability.text}</p>
        <a class="footer__contact" href={company.phone.href}>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          <span>{company.phone.display}</span>
        </a>
      </div>

      <div>
        <h2 class="footer__h">Consultas y proveedores</h2>
        <p class="footer__note">Empresas, alianzas e inscripción a la red</p>
        <a class="footer__contact" href={company.email.href}>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span>{company.email.display}</span>
        </a>
      </div>

      <nav aria-label="Pie de página">
        <h2 class="footer__h">Navegación</h2>
        <ul class="footer__links">
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/privacidad">Aviso de privacidad</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} {company.legalName}. Todos los derechos reservados.</p>
      <p class="footer__mark" aria-hidden="true"></p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--brand-navy-deep); color: var(--color-text-on-dark); padding-block: var(--s-12) var(--s-8); }
  @media (min-width: 768px) { .footer { padding-block: var(--s-16) var(--s-8); } }
  .footer__grid { display: grid; gap: var(--s-8); grid-template-columns: 1fr; }
  @media (min-width: 480px) { .footer__grid { grid-template-columns: 1fr 1fr; } .footer__brand { grid-column: 1 / -1; } }
  @media (min-width: 1024px) { .footer__brand { grid-column: auto; } }
  @media (min-width: 1024px) { .footer__grid { grid-template-columns: 1.6fr 1fr 1fr 0.8fr; gap: var(--s-12); } }
  .footer__brand img { width: 160px; height: auto; margin-bottom: var(--s-4); }
  .footer__legal { font-weight: 600; color: #fff; }
  .footer__mission { margin-top: var(--s-4); color: var(--color-text-on-dark-muted); font-size: var(--fs-small); max-width: 42ch; text-wrap: pretty; }
  .footer__h { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #8FB4D9; margin-bottom: var(--s-3); }
  .footer__note { color: var(--color-text-on-dark-muted); font-size: var(--fs-small); margin-bottom: var(--s-3); }
  .footer__contact { display: inline-flex; align-items: center; gap: var(--s-3); color: #fff; font-weight: 700; text-decoration: none; min-height: 44px; }
  .footer__contact:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .footer__links { display: flex; flex-direction: column; gap: var(--s-1); }
  .footer__links a { display: inline-flex; align-items: center; min-height: 40px; color: #fff; text-decoration: none; }
  .footer__links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer__bottom { margin-top: var(--s-12); padding-top: var(--s-6); border-top: 1px solid rgba(255,255,255,0.14); display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); font-size: var(--fs-small); color: var(--color-text-on-dark-muted); }
  .footer__mark { width: 56px; height: 4px; border-radius: 2px; background: linear-gradient(90deg, #fff 0 50%, var(--brand-blue) 50% 100%); }
</style>
