---
import { hero, services, process } from '../content/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy rise">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">{hero.title}</h1>
    <p class="lead">{hero.text}</p>
    <div class="hero__actions">
      <a href={hero.cta.href} class="btn btn--primary">{hero.cta.label}</a>
      <a href={hero.link.href} class="btn btn--outline">{hero.link.label}</a>
    </div>
  </div>

  <!--
    Panel de marca (sin fotografía). La foto del sitio actual es un recurso Getty licenciado
    por el constructor de GoDaddy y no se reutiliza. Sustituir el panel por fotografía propia o
    licenciada cuando dirección la entregue: ver docs/ASSETS.md.
  -->
  <div class="hero__panel" aria-hidden="true">
    <ol class="hero__steps">
      {process.steps.map((st, i) => (
        <li class:list={['hero__step', { 'hero__step--done': i === process.steps.length - 1 }]}>
          <span class="hero__step-dot"></span>
          <span class="hero__step-name">{st.name}</span>
        </li>
      ))}
    </ol>
    <svg class="hero__art" viewBox="0 0 560 400" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path class="hero__path" d="M56 300 C 130 300, 150 150, 250 150 S 350 250, 420 220 S 470 110, 500 86" stroke="#FFFFFF" stroke-opacity="0.9" stroke-width="5" stroke-linecap="round"/>
      <g class="hero__node hero__node--1"><circle cx="56" cy="300" r="20" fill="#FFFFFF" fill-opacity="0.12"/><circle cx="56" cy="300" r="9" fill="#FFFFFF"/></g>
      <g class="hero__node hero__node--2"><circle cx="250" cy="150" r="20" fill="#FFFFFF" fill-opacity="0.12"/><circle cx="250" cy="150" r="9" fill="#FFFFFF"/></g>
      <g class="hero__node hero__node--3"><circle cx="420" cy="220" r="20" fill="#FFFFFF" fill-opacity="0.12"/><circle cx="420" cy="220" r="9" fill="#FFFFFF"/></g>
      <g class="hero__node hero__node--4"><circle cx="500" cy="86" r="26" fill="#0E62AC"/><path d="M489 86l8 8 14-16" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></g>
      <g font-family="'Red Hat Display', system-ui, sans-serif" font-weight="700" font-size="19" fill="#FFFFFF">
        <text x="26" y="352">Recepción</text>
        <text x="190" y="114">Coordinación</text>
        <text x="366" y="272">Seguimiento</text>
      </g>
    </svg>
    <ul class="hero__chips">
      {services.map((s) => <li>{s.name}</li>)}
      <li class="hero__chip--accent">24/7</li>
    </ul>
  </div>
</section>

<style>
  /* Móvil: una columna dentro de los márgenes normales */
  .hero { display: grid; grid-template-columns: 1fr; gap: var(--s-8); padding: var(--s-8) var(--gutter) var(--s-12); background: var(--color-surface); }
  .hero__copy { max-width: 36rem; }
  .hero__copy .eyebrow { margin-bottom: var(--s-4); }
  .hero__copy h1 { margin-bottom: var(--s-4); }
  .hero__copy .lead { margin-bottom: var(--s-6); }
  .hero__actions { display: grid; grid-template-columns: 1fr; gap: var(--s-3); }
  @media (min-width: 640px) { .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: center; } }

  /* Stepper compacto (solo móvil) */
  .hero__steps { display: grid; grid-template-columns: repeat(3, 1fr); position: relative; padding-top: var(--s-2); }
  .hero__steps::before { content: ''; position: absolute; left: 16.6%; right: 16.6%; top: calc(var(--s-2) + 9px); height: 3px; background: rgba(255,255,255,0.35); border-radius: 2px; }
  .hero__step { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--s-3); text-align: center; }
  .hero__step-dot { position: relative; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 6px rgba(255,255,255,0.14); }
  .hero__step--done .hero__step-dot { background: var(--brand-blue); box-shadow: 0 0 0 6px rgba(14,98,172,0.35); }
  .hero__step--done .hero__step-dot::after { content: ''; position: absolute; left: 7px; top: 4px; width: 5px; height: 9px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .hero__step-name { font-family: var(--font-display); font-weight: 700; font-size: 0.75rem; color: #fff; }
  @media (min-width: 360px) { .hero__step-name { font-size: 0.8125rem; } }
  @media (min-width: 400px) { .hero__step-name { font-size: var(--fs-small); } }
  .hero__art { display: none; }

  .hero__panel {
    position: relative; background: var(--brand-navy-deep); color: #fff;
    border-radius: var(--radius); padding: var(--s-6);
    display: flex; flex-direction: column; gap: var(--s-6); overflow: hidden;
  }
  .hero__panel::before {
    content: ''; position: absolute; inset: auto -20% -40% auto; width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: var(--brand-blue); opacity: 0.35; filter: blur(60px); pointer-events: none;
  }
  @media (min-width: 900px) { .hero__art { display: block; position: relative; width: 100%; max-width: 560px; height: auto; } .hero__steps { display: none; } }
  .hero__chips { position: relative; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .hero__chips li {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--s-3);
    border-radius: var(--radius-pill); border: 1px solid rgba(255,255,255,0.25);
    font-family: var(--font-display); font-weight: 600; font-size: var(--fs-small); color: #fff;
  }
  .hero__chip--accent { background: var(--brand-blue); border-color: var(--brand-blue) !important; }

  .hero__path { stroke-dasharray: 900; stroke-dashoffset: 900; animation: draw 1.4s var(--ease) 200ms forwards; }
  .hero__node { opacity: 0; animation: pop 400ms var(--ease) forwards; }
  .hero__node--1 { animation-delay: 300ms; } .hero__node--2 { animation-delay: 650ms; }
  .hero__node--3 { animation-delay: 1000ms; } .hero__node--4 { animation-delay: 1400ms; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { from { opacity: 0; transform: scale(0.85); transform-origin: center; } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero__path { stroke-dashoffset: 0; animation: none; } .hero__node { opacity: 1; animation: none; } }

  /* Escritorio: dos columnas dentro del contenedor; el panel es una tarjeta alineada
     con el borde derecho del contenedor (mismo eje que el botón del header) */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr; gap: var(--s-12); align-items: center;
      width: 100%; max-width: var(--container); margin-inline: auto;
      padding: var(--s-16) var(--gutter);
    }
    .hero__copy { max-width: none; padding-right: var(--s-8); }
    .hero__copy h1 { max-width: 11ch; }
    .hero__panel { padding: var(--s-12) var(--s-10, 40px); min-height: 520px; justify-content: center; border-radius: 24px; }
    .hero__art { max-width: 600px; }
  }
  @media (min-width: 1200px) {
    .hero { padding-block: var(--s-24); gap: var(--s-16); }
    .hero__panel { padding: var(--s-16) var(--s-12); }
  }
</style>
